<script>
  // Step switcher
  const visuals = [
    { icon: '📋', title: 'Diiwaangelinta Bukaanka', sub: 'Geli macluumaadka bukaanka si degdeg ah. Waa la raadin karaa gudaha 5 ilbiriqsi marka ay ku soo laabataan.' },
    { icon: '📅', title: 'Ballansasho & Jadwal', sub: 'Xulo dhakhtarka iyo wakhtiga. Nidaamku si toos ah ayuu u xaqiijiyaa inuusan khilaafka lahayn.' },
    { icon: '👥', title: 'Maareynta Safafka', sub: 'Daawashada bukaanka xiga iyo wakhtiga sugitaanka. Maamuluhu waa arki karaa xaaladda oo dhan.' },
    { icon: '📊', title: 'Warbixinta & Falanqaynta', sub: 'Warbixinno toos ah oo muujinaysa tirada bukaanka, wakhtiga sugitaanka, iyo xaaladda rugta.' }
  ];
  function activateStep(el, idx) {
    document.querySelectorAll('.step').forEach(s => s.classList.remove('active'));
    el.classList.add('active');
    document.getElementById('vIcon').textContent = visuals[idx].icon;
    document.getElementById('vTitle').textContent = visuals[idx].title;
    document.getElementById('vSub').textContent = visuals[idx].sub;
  }

  // Scroll reveal
  const observer = new IntersectionObserver(entries => {
    entries.forEach(e => { if(e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.15 });
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

  // Auto-cycle steps
  let curr = 0;
  setInterval(() => {
    curr = (curr + 1) % 4;
    const steps = document.querySelectorAll('.step');
    activateStep(steps[curr], curr);
  }, 3000);
</script>
</body>
</html>