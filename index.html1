<!-- HOW IT WORKS -->
<section class="how" id="how">
  <div class="section-label">Habka Shaqada</div>
  <h2 class="section-title">Sida nidaamku<br><em>u shaqeeyo</em></h2>
  <div class="how-grid reveal">
    <div class="steps">
      <div class="step active" onclick="activateStep(this, 0)">
        <div class="step-bar"></div>
        <div class="step-num">01</div>
        <div class="step-body">
          <div class="step-title">Diiwaangelinta Bukaanka</div>
          <div class="step-desc">Shaqaalaha qaabilka waxay geliyaan macluumaadka bukaanka cusub — magac, aqoonsi, xiriir, iyo taariikh caafimaadeed — hal mar. Bukaanka soo noqnoqda way si degdeg ah u helaan.</div>
        </div>
      </div>
      <div class="step" onclick="activateStep(this, 1)">
        <div class="step-bar"></div>
        <div class="step-num">02</div>
        <div class="step-body">
          <div class="step-title">Ballansasho & Jadwal</div>
          <div class="step-desc">Xulo dhakhtarka, taariikhda, iyo wakhtiga — nidaamku si toos ah ayuu u xaqiijiyaa inuusan halkan lahayn bukaankale. Khilaafka ballanqaadka ma dhici karo.</div>
        </div>
      </div>
      <div class="step" onclick="activateStep(this, 2)">
        <div class="step-bar"></div>
        <div class="step-num">03</div>
        <div class="step-body">
          <div class="step-title">Maareynta Safafka</div>
          <div class="step-desc">Meja qaabilka ayaa muujiya bukaanka xiga iyo wakhtiga sugitaanka la filayo. Maamuluhu waa arki karaa xaaladda rugta oo dhan hal shaashadood.</div>
        </div>
      </div>
      <div class="step" onclick="activateStep(this, 3)">
        <div class="step-bar"></div>
        <div class="step-num">04</div>
        <div class="step-body">
          <div class="step-title">Warbixinta & Falanqaynta</div>
          <div class="step-desc">Warbixinno maalinle, toddobaadleye, iyo bileedba waxay muujiyaan tirada bukaanka, wakhtiga sugitaanka celceliska ah, iyo xaaladda guud ee rugta.</div>
        </div>
      </div>
    </div>
    <div class="step-visual" id="stepVisual">
      <div class="visual-icon" id="vIcon">📋</div>
      <div class="visual-title" id="vTitle">Diiwaangelinta Bukaanka</div>
      <div class="visual-sub" id="vSub">Geli macluumaadka bukaanka si degdeg ah. Waa la raadin karaa gudaha 5 ilbiriqsi marka ay ku soo laabataan.</div>
    </div>
  </div>
</section>

<!-- FEATURES -->
<section class="features" id="features">
  <div class="section-label">Astaamaha</div>
  <h2 class="section-title">Wax kasta oo aad<br><em>u baahan tahay</em></h2>
